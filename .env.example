# Copie para .env (na raiz do repositório) e preencha. O .env não é versionado.
# Variáveis já definidas no ambiente têm prioridade sobre este arquivo.

# Chave da API da função listarprojetos do Zoho CRM (zapikey).
ZOHO_ZAPIKEY=

# Token do header access-token do ApiManager (o mesmo em teste e prod).
APIMANAGER_ACCESS_TOKEN=

# URL base do ApiManager em cada ambiente (escolhido com -ambiente teste|prod).
APIMANAGER_URL_TESTE=https://localhost:7119
APIMANAGER_URL_PROD=https://apimanager.macrolabs.app
